# Path to the TOML config; the only environment variable the app reads.
# The config itself arrives with the contour ticket (.config/config.toml).
APP_CONFIG_PATH=.config/config.toml

# The owner's single admin account; `memiro django ensure_superuser` reads them.
MEMIRO_ADMIN_USERNAME=owner
MEMIRO_ADMIN_PASSWORD=owner

# Image tag the compose pulls: `dev` for a pre-release check, `vX.Y.Z` on
# production. `just up` builds locally under the same name.
MEMIRO_IMAGE_TAG=dev

# Password of the Postgres service; production sets a real one and repeats it
# in .config/config.prod.toml.
MEMIRO_DB_PASSWORD=memiro

# Baked into the storefront bundle at build time (CI takes them from the
# repository variables; locally they matter only for `just up`).
PUBLIC_SITE_URL=https://memiro.ru
PUBLIC_METRIKA_ID=
