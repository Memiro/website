# Django
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: пустой POSTGRES_HOST → SQLite (разработка без docker);
# внутри контура docker-compose.yaml подставляет host и port сам
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=memiro
POSTGRES_PASSWORD=memiro
POSTGRES_DB=memiro

# Уведомление о заявке: без токена и чата заявка просто пишется в лог.
# INQUIRY_NOTIFIER подменяет транспорт целиком (тесты ставят свой)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Номер счётчика Яндекс.Метрики. Пусто — аналитики нет и cookie-баннер
# не показывается; заполнено — счётчик грузится только после согласия
YANDEX_METRIKA_ID=
