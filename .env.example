# Django
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: пустой POSTGRES_HOST → SQLite (разработка без docker);
# внутри контура docker-compose.yaml подставляет host и port сам
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=memiro
POSTGRES_PASSWORD=memiro
POSTGRES_DB=memiro

# Уведомление о заявке письмом: без адреса менеджера заявка просто
# пишется в журнал и в лог. INQUIRY_NOTIFIER подменяет транспорт целиком
# (тесты ставят свой). EMAIL_HOST_PASSWORD для Яндекс.Почты — пароль
# приложения, обычный пароль от ящика SMTP не примет
INQUIRY_MANAGER_EMAIL=
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Номер счётчика Яндекс.Метрики. Пусто — аналитики нет и cookie-баннер
# не показывается; заполнено — счётчик грузится только после согласия
YANDEX_METRIKA_ID=
