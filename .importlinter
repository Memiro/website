[importlinter]
root_packages =
    memiro
    memiro_common
include_external_packages = True

[importlinter:contract:layers]
name = The layers point inward: entities <- application <- adapters <- presentation <- bootstrap
type = layers
layers =
    memiro.bootstrap
    memiro.presentation
    memiro.adapters
    memiro.application
    memiro.entities

[importlinter:contract:common-knows-no-context]
name = memiro_common knows nothing of the contexts
type = forbidden
source_modules =
    memiro_common
forbidden_modules =
    memiro

[importlinter:contract:domain-is-pure]
name = entities and application never import frameworks (fastapi, sqlalchemy, dishka, django)
type = forbidden
source_modules =
    memiro.entities
    memiro.application
forbidden_modules =
    fastapi
    sqlalchemy
    alembic
    dishka
    django

; Interim half of decision 41: until presentation.django_admin and
; bootstrap.django_admin exist (ticket 16), django appears nowhere at all.
; Ticket 16 replaces this with the precise django_admin contracts.
[importlinter:contract:no-django-yet]
name = django is imported nowhere until the admin presentation lands
type = forbidden
source_modules =
    memiro
    memiro_common
forbidden_modules =
    django

[importlinter:contract:application-features]
name = Application features know nothing of each other; what two of them need lives in application/common
type = independence
modules =
    memiro.application.browse_catalog
    memiro.application.calculate_price
    memiro.application.manage_products
    memiro.application.submit_inquiry

[importlinter:contract:manage-products-scenarios]
name = Product-management scenarios communicate only through their shared module
type = independence
modules =
    memiro.application.manage_products.add_variant
    memiro.application.manage_products.change_variant
    memiro.application.manage_products.duplicate_variant_with_size
    memiro.application.manage_products.remove_variant
