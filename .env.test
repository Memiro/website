# Django
DJANGO_SECRET_KEY=test-only-insecure-key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The e2e-test client (host port of the test contour)
WEB_URL=http://127.0.0.1:8001

# PostgreSQL: host and port are for whoever comes from the host;
# inside the contour docker-compose.yaml overrides them
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=memiro
POSTGRES_PASSWORD=memiro
POSTGRES_DB=memiro
