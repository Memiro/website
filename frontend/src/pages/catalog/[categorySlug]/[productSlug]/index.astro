---
import Calculator from "../../../../islands/Calculator.vue";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { CatalogApi } from "../../../../lib/catalog-api";

const api = new CatalogApi(import.meta.env.API_INTERNAL_URL ?? "http://api:8000");
const product = await api.product(Astro.params.productSlug ?? "");
const price = product.price_from === null ? null : new Intl.NumberFormat("ru-RU").format(Number(product.price_from));
---

<BaseLayout title={`${product.name} — Memiro`}>
  <main class="pdp wrap">
    <div class="gallery solo"><div class="main" aria-hidden="true"></div></div>
    <div class="info"><h1>{product.name}</h1><p class="desc">{product.description}</p>{price !== null && <div class="price-row"><span class="price-now">от {price} ₽</span><span class="price-note">цена минимальной конфигурации</span></div>}<div class="variants"><h2>Типовые размеры</h2><table><tbody>{product.variants.map((variant) => <tr><th scope="row">{variant.width_mm} × {variant.height_mm} мм</th><td class="variant-price">{new Intl.NumberFormat("ru-RU").format(Number(variant.price))} ₽</td></tr>)}</tbody></table></div><Calculator client:visible product={product} /></div>
  </main>
</BaseLayout>
