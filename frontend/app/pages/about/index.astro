---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHead from "../../components/PageHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ordinal } from "../../lib/ordinal.ts";
import { readSite } from "../../lib/site-api.ts";

const crumbs = [{ href: "/", label: "Главная" }, { href: "/about/", label: "О нас" }];
const email = (await readSite()).contacts?.email ?? "";

const FEATURES = [
  { title: "Собственное производство", text: "Контролируем все этапы производства: от закупки материалов до упаковки готового зеркала." },
  { title: "Зеркало под ключ", text: "Выполняем все работы от замера до монтажа. Привозим и устанавливаем силами своих мастеров." },
  { title: "По вашим пожеланиям", text: "Сделаем зеркало нестандартной формы и размера — по фото, эскизу или просто описанию." },
  { title: "Гарантия 1 год", text: "Все изделия имеют гарантию и гарантийное обслуживание. Используем проверенные комплектующие." },
];
---

<BaseLayout
  title="О нас — Memiro"
  description="Memiro — студия интерьерных зеркал в Санкт-Петербурге с собственным производством: проектируем, изготавливаем и устанавливаем зеркала на заказ."
  crumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <PageHead label="Собственное производство · Санкт-Петербург" heading="О нас" />
  <div class="wrap page">
    <div class="page__lead">
      <p>Memiro — студия зеркал в Санкт-Петербурге с собственным производством. Проектируем, изготавливаем и устанавливаем зеркала для интерьера: от классических настенных до фигурных с подсветкой по индивидуальному эскизу.</p>
      <p>Мы контролируем все этапы — от закупки материалов до упаковки и монтажа, поэтому уверены в качестве каждого изделия. На все зеркала действует гарантия 1 год.</p>
    </div>

    <ol class="rows">
      {FEATURES.map((feature, index) => (
        <li>
          <span class="rows__n">{ordinal(index + 1)}</span>
          <h2>{feature.title}</h2>
          <p>{feature.text}</p>
        </li>
      ))}
    </ol>

    <section class="page__section">
      <h2>Сотрудничество</h2>
      <p>Приглашаем к сотрудничеству дизайнеров и дизайн-студии: внимательные менеджеры, скидки и индивидуальный подход к каждому проекту. Напишите нам{email === "" ? "" : " — "}{email !== "" && <a href={`mailto:${email}`}>{email}</a>}.</p>
    </section>
  </div>
</BaseLayout>
