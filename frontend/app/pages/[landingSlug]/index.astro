---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CatalogCard from "../../components/CatalogCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import NotFound from "../../components/NotFound.astro";
import OfferNote from "../../components/OfferNote.astro";
import PageHead from "../../components/PageHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { internalCatalogApi, type CategoryPage, type Landing } from "../../lib/catalog-api.ts";
import { catalogSearch, isNarrowed, pageNumbers, parseCatalogQuery, withPage } from "../../lib/catalog-query.ts";
import { foundOrNull } from "../../lib/not-found.ts";
import { listingCanonicalPath, listingRobots, productListJsonLd } from "../../lib/seo.ts";

const api = internalCatalogApi();
const landingSlug = Astro.params.landingSlug ?? "";
const path = `/${landingSlug}/`;
const landing: Landing | null = await foundOrNull(landingSlug, (slug) => api.landing(slug));
if (landing === null) {
  Astro.response.status = 404;
}

// A landing narrows its category by the values the owner wrote down; the
// visitor may still page through what they leave.
const asked = parseCatalogQuery(Astro.url.searchParams);
const query = landing === null ? asked : { ...asked, values: landing.values };
const page: CategoryPage | null = landing === null
  ? null
  : await foundOrNull(landing.category_slug, (slug) => api.categoryProducts(slug, catalogSearch(query)));
const listing = page === null || landing === null || isNarrowed(asked)
  ? null
  : productListJsonLd(Astro.site, landing.category_slug, page.items);
const paragraphs = landing === null ? [] : landing.text.split("\n").filter((line) => line.trim() !== "");
const crumbs = landing === null ? [] : [
  { href: "/", label: "Главная" },
  { href: "/catalog/", label: "Каталог" },
  { href: `/catalog/${landing.category_slug}/`, label: landing.category_name },
  { href: path, label: landing.heading },
];
---

{landing === null || page === null ? (
  <NotFound
    heading="Страница не найдена"
    lead="Возможно, в адресе опечатка или страница больше не публикуется."
    description="Такой страницы нет на сайте Memiro."
  />
) : (
  <BaseLayout
    title={landing.title}
    description={landing.description}
    robots={listingRobots(asked)}
    canonicalPath={listingCanonicalPath(path, asked)}
    crumbs={crumbs}
    jsonLd={listing === null ? [] : [listing]}
  >
    <Breadcrumbs crumbs={crumbs} />
    <PageHead label={landing.category_name} heading={landing.heading} count={page.total} />

    {paragraphs.length > 0 && (
      <div class="wrap landing-text">{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
    )}

    <div class="wrap page-body">
      <main>
        {page.items.length > 0 ? (
          <div class="grid-4">{page.items.map((product) => <CatalogCard categorySlug={landing.category_slug} product={product} />)}</div>
        ) : (
          <EmptyState text="Под эту подборку сейчас ничего не подошло — посмотрите весь раздел." href={`/catalog/${landing.category_slug}/`} action="Весь раздел" />
        )}

        {page.pages > 1 && (
          <nav class="pager" aria-label="Страницы подборки">
            {pageNumbers(page.pages).map((number) => (
              <a class={number === page.page ? "here" : undefined} href={withPage(path, asked, number)} aria-current={number === page.page ? "page" : undefined}>{number}</a>
            ))}
            {page.page < page.pages && <a class="btn btn--ghost btn--sm" href={withPage(path, asked, page.page + 1)}>Ещё<span class="arrow">→</span></a>}
          </nav>
        )}

        <p class="landing-all">
          <a class="link-underline" href={`/catalog/${landing.category_slug}/`}>Весь раздел «{landing.category_name}» →</a>
        </p>

        <OfferNote />
      </main>
    </div>
  </BaseLayout>
)}
