---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EmptyState from "../../components/EmptyState.astro";
import PageHead from "../../components/PageHead.astro";
import WorkTile from "../../components/WorkTile.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { internalCatalogApi } from "../../lib/catalog-api.ts";

const crumbs = [{ href: "/", label: "Главная" }, { href: "/works/", label: "Наши работы" }];

const works = (await internalCatalogApi().works()).items;
---

<BaseLayout
  title="Наши работы — Memiro"
  description="Фотографии зеркал Memiro в интерьерах клиентов: реальные установки в Санкт-Петербурге."
  crumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <PageHead label="Фотографии установок" heading="Наши работы" />
  <div class="wrap page">
    <div class="page__lead"><p>Фотографии реальных установок: зеркала, которые мы сделали и повесили у наших клиентов.</p></div>
    {works.length > 0 ? (
      <div class="works">
        {works.map((work) => <WorkTile work={work} />)}
      </div>
    ) : (
      <EmptyState text="Раздел наполняется — загляните позже или посмотрите каталог." href="/catalog/" action="В каталог" />
    )}
  </div>
</BaseLayout>
