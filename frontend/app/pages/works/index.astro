---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { productPath } from "../../lib/navigation.ts";
import { WORKS } from "../../lib/works.ts";

const crumbs = [{ href: "/", label: "Главная" }, { href: "/works/", label: "Наши работы" }];
---

<BaseLayout
  title="Наши работы — Memiro"
  description="Фотографии зеркал Memiro в интерьерах клиентов: реальные установки в Санкт-Петербурге."
  crumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <div class="page wrap">
    <span class="overline">Фотографии установок</span>
    <h1 class="h-section">Наши работы</h1>
    <p class="page-lead">Фотографии реальных установок: зеркала, которые мы сделали и повесили у наших клиентов.</p>

    {WORKS.length > 0 ? (
      <div class="works-grid">
        {WORKS.map((work) => (
          <figure class="work">
            {work.product === null ? (
              <Fragment>
                <div class="pic"><img src={work.image} alt={work.title} loading="lazy" /></div>
                <figcaption>{work.title}</figcaption>
              </Fragment>
            ) : (
              <a class="card-link" href={productPath(work.product.categorySlug, work.product.slug)}>
                <div class="pic"><img src={work.image} alt={work.title} loading="lazy" /></div>
                <figcaption>{work.title} <span class="work-go">Смотреть зеркало →</span></figcaption>
              </a>
            )}
          </figure>
        ))}
      </div>
    ) : (
      <p class="muted">Раздел наполняется — загляните позже или посмотрите <a href="/catalog/">каталог</a>.</p>
    )}
  </div>
</BaseLayout>
