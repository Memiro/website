---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import OfferNote from "../../components/OfferNote.astro";
import InquiryCart from "../../islands/InquiryCart.vue";
import BaseLayout from "../../layouts/BaseLayout.astro";

const crumbs = [{ href: "/", label: "Главная" }, { href: "/cart/", label: "Заявка" }];
---

<BaseLayout
  title="Ваша заявка — Memiro"
  description="Подборка зеркал Memiro: отправьте её менеджеру, и он рассчитает стоимость под ваши размеры."
  robots="noindex, follow"
  crumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <section class="wrap page">
    <span class="overline">Зеркала, которые вы выбрали</span>
    <h1 class="h-section">Ваша заявка</h1>
    <p class="page-lead">Соберите подборку — менеджер рассчитает стоимость под ваши размеры и свяжется в течение рабочего дня. Оплаты на сайте нет.</p>
    <InquiryCart client:only="vue" />
    <OfferNote />
  </section>
</BaseLayout>
