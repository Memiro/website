---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHead from "../../components/PageHead.astro";
import OfferNote from "../../components/OfferNote.astro";
import InquiryCart from "../../islands/InquiryCart.vue";
import BaseLayout from "../../layouts/BaseLayout.astro";

const crumbs = [{ href: "/", label: "Главная" }, { href: "/cart/", label: "Заявка" }];
---

<BaseLayout
  title="Ваша заявка — Memiro"
  description="Подборка зеркал Memiro: отправьте её менеджеру, и он рассчитает стоимость под ваши размеры."
  robots="noindex, follow"
  crumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <PageHead label="Зеркала, которые вы выбрали" heading="Ваша заявка" />
  <div class="wrap page">
    <div class="page__lead"><p>Соберите подборку — менеджер рассчитает стоимость под ваши размеры и свяжется в течение рабочего дня. Оплаты на сайте нет.</p></div>
    <InquiryCart client:only="vue" />
    <OfferNote />
  </div>
</BaseLayout>
