---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import IndexRow from "../../components/IndexRow.astro";
import PageHead from "../../components/PageHead.astro";
import SellerRequisites from "../../components/SellerRequisites.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { businessJsonLd } from "../../lib/seo.ts";
import { addressLine, readSite, socialLinks } from "../../lib/site-api.ts";

const crumbs = [{ href: "/", label: "Главная" }, { href: "/contacts/", label: "Контакты" }];
const site = await readSite();
const contacts = site.contacts;
const social = contacts === null ? [] : socialLinks(contacts);
---

<BaseLayout
  title="Контакты — Memiro"
  description="Адрес шоурума, телефон и почта мастерской интерьерных зеркал Memiro в Санкт-Петербурге."
  crumbs={crumbs}
  jsonLd={[businessJsonLd(Astro.site, contacts)]}
>
  <Breadcrumbs crumbs={crumbs} />
  <PageHead label="Шоурум и связь" heading="Контакты" />
  <div class="wrap page">
    <div class="contacts">
      <div>
        <dl class="contacts__list">
          {contacts !== null && (
            <div>
              <dt>Шоурум</dt>
              <dd>{addressLine(contacts)}</dd>
              <dd>{contacts.hours} — напишите или позвоните заранее, встретим и всё покажем.</dd>
            </div>
          )}
          {contacts !== null && contacts.phone !== "" && (
            <div>
              <dt>Телефон</dt>
              <dd><a href={`tel:${contacts.phone}`}>{contacts.phone_display}</a></dd>
            </div>
          )}
          {contacts !== null && contacts.email !== "" && (
            <div>
              <dt>Почта</dt>
              <dd><a href={`mailto:${contacts.email}`}>{contacts.email}</a></dd>
            </div>
          )}
          {social.length > 0 && (
            <div>
              <dt>Мессенджеры и соцсети</dt>
              <dd>
                <ul class="index">{social.map((link) => <IndexRow href={link.value} label={link.label} external />)}</ul>
              </dd>
            </div>
          )}
          {site.seller.length > 0 && (
            <div>
              <dt>Реквизиты продавца</dt>
              <dd><SellerRequisites seller={site.seller} /></dd>
            </div>
          )}
        </dl>
        <p class="contacts__policy"><a href="/privacy/">Политика обработки персональных данных</a></p>
      </div>
      {/* The widget sets cookies of its own, so it arrives on the visitor's click — a local consent, not the analytics banner (ADR-0006). */}
      {contacts !== null && contacts.map_embed !== "" && (
        <div class="contacts__map" data-map data-map-src={contacts.map_embed} data-map-title={`Шоурум memiro на карте: ${addressLine(contacts)}`}>
          <div class="map-placeholder">
            <p>Карта загружается с сервиса Яндекс.Карт: он может сохранять файлы cookie в вашем браузере.</p>
            <button class="btn btn--ghost btn--sm" type="button" data-map-load>Показать карту</button>
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { mountShowroomMap } from "../../islands/map.ts";

  mountShowroomMap(document);
</script>
