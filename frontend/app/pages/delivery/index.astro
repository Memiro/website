---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageHead from "../../components/PageHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Rows from "../../components/Rows.astro";

const crumbs = [{ href: "/", label: "Главная" }, { href: "/delivery/", label: "Доставка и возврат" }];

const OPTIONS = [
  { title: "Самовывоз", text: "Самовывоз с производства в Санкт-Петербурге, помощь в погрузке в ваш автомобиль — бесплатно." },
  { title: "По Санкт-Петербургу и Ленобласти", text: "Привозим сами. Стоимость зависит от дальности поездки, количества зеркал и их габаритов. Выгрузка и доставка до квартиры на лифте входят в стоимость; ручной подъём по лестнице выше первого этажа — дополнительная услуга." },
  { title: "По России", text: "Отправляем транспортными компаниями. Стоимость — от 2 000 ₽, рассчитывается индивидуально." },
  { title: "Установка", text: "Вешаем сами: аккуратно, с уровнем и крепежом под вашу стену. Стоимость зависит от вида и сложности работ." },
];
---

<BaseLayout
  title="Доставка и возврат — Memiro"
  description="Условия доставки, установки и возврата зеркал мастерской Memiro: самовывоз, доставка по Санкт-Петербургу и России, монтаж, оплата."
  crumbs={crumbs}
>
  <Breadcrumbs crumbs={crumbs} />
  <PageHead label="Условия" heading="Доставка и возврат" />
  <div class="wrap page">
    <Rows items={OPTIONS} />

    <section class="legal-note">
      <h2>Возврат</h2>
      <p>Наши зеркала изготавливаются под заказ по индивидуальным размерам и параметрам покупателя. Такие товары надлежащего качества <strong>обмену и возврату не подлежат</strong> (ст. 26.1 Закона РФ «О защите прав потребителей»).</p>
      <p>Если изделие пришло с браком или повреждено при доставке — сфотографируйте его при получении и свяжитесь с нами: заменим или устраним недостатки за свой счёт.</p>
    </section>

    <section class="page__section">
      <h2>Оплата</h2>
      <p>Для физических лиц — предоплата 50% при заказе, остаток при получении. Для юридических лиц — предоплата 100%. Точные условия подтверждает менеджер при согласовании заявки.</p>
    </section>
  </div>
</BaseLayout>
