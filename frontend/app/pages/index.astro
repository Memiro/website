---
import { Picture } from "astro:assets";

import heroBedroom from "../assets/hero-bedroom.jpg";
import CatalogCard from "../components/CatalogCard.astro";
import CatalogTiles from "../components/CatalogTiles.astro";
import IndexRow from "../components/IndexRow.astro";
import OfferNote from "../components/OfferNote.astro";
import Rows from "../components/Rows.astro";
import InquiryForm from "../islands/InquiryForm.vue";
import BaseLayout from "../layouts/BaseLayout.astro";
import { internalCatalogApi, type Category, type ProductSummary } from "../lib/catalog-api.ts";
import { businessJsonLd, organizationJsonLd } from "../lib/seo.ts";
import { ordinal } from "../lib/ordinal.ts";
import { readSite, socialLinks } from "../lib/site-api.ts";
import { catalogTiles, type Tile } from "../lib/tiles.ts";

const SHOWCASE_SIZE = 4;
const ADVANTAGES = [
  "Своё производство — цена без посредников",
  "Зеркало по вашему эскизу",
  "Комплектующие проверенных производителей",
  "Доставка и монтаж по городу",
];
const STEPS = [
  { title: "Выбор", text: "Выбираете зеркало в каталоге или присылаете свой эскиз. Размер и опции обсуждаются под вашу задачу." },
  { title: "Согласование", text: "Менеджер уточняет детали, подтверждает размеры, сроки и итоговую стоимость." },
  { title: "Изготовление", text: "Делаем зеркало в собственной мастерской — от 1 рабочего дня. Срок зависит от сложности, точный называет менеджер." },
  { title: "Доставка и монтаж", text: "Привозим и вешаем сами: аккуратно, с уровнем и крепежом под вашу стену." },
];
const api = internalCatalogApi();
const site = await readSite();
const contacts = site.contacts;
const social = contacts === null ? [] : socialLinks(contacts);

// The storefront survives an API that is down: the home page is still the
// studio's front door, and its content blocks simply stay away.
let tiles: Tile[] = [];
let showcase: { category: Category; products: ProductSummary[] } | null = null;
try {
  tiles = await catalogTiles(api);
  const [first] = (await api.categories()).items;
  if (first !== undefined) {
    showcase = { category: first, products: (await api.categoryProducts(first.slug)).items.slice(0, SHOWCASE_SIZE) };
  }
} catch {
  tiles = [];
}

// Sections are numbered in render order, so the count stays continuous when
// the catalogue blocks stay away.
let sectionCount = 0;
const sectionNumber = (): string => ordinal(++sectionCount);
---

<BaseLayout
  title="Зеркала на заказ в Санкт-Петербурге — мастерская Memiro"
  description="Мастерская Memiro в Санкт-Петербурге: интерьерные зеркала на заказ любой сложности — изготовление, доставка и монтаж."
  jsonLd={[businessJsonLd(Astro.site, contacts), organizationJsonLd(Astro.site)]}
>
  <section class="wrap hero">
    <div class="hero__text">
      <p class="label">Мастерская зеркал · Санкт-Петербург · с 2021</p>
      <h1>Зеркала на заказ <span class="accent">любой</span> сложности</h1>
      <p class="lede">Быстро и качественно изготовим и установим зеркало любой сложности, даже если другие компании отказались.</p>
      <div class="hero__actions">
        <a class="btn" href="/catalog/">В каталог <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#inquiry">По своему эскизу</a>
      </div>
      <div class="hero__facts">
        <div><b>от 1 раб. дня</b><span class="label">изготовление</span></div>
        <div><b>1 год</b><span class="label">гарантия</span></div>
        <div><b>с 2021</b><span class="label">собственное производство</span></div>
      </div>
    </div>
    <div class="hero__media">
      <figure>
        {/* The build makes the WebP copies and the srcset of this one: a
            picture of the repository is converted by the pipeline, not by
            hand, and its name carries a hash that may be cached for ever. */}
        <Picture
          src={heroBedroom}
          formats={["webp"]}
          widths={[480, 960, 1200]}
          sizes="(max-width: 900px) 100vw, 50vw"
          alt="Арочное зеркало с контурной подсветкой в спальне"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="chip"><span class="chip__n">Арка</span>с контурной подсветкой</figcaption>
      </figure>
      {tiles.length > 0 && (
        <ul class="index" aria-label="Категории">
          {tiles.map((tile) => (
            <IndexRow href={tile.href} label={tile.label} />
          ))}
        </ul>
      )}
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[0, 1].map(() => (
        <span>{ADVANTAGES.map((advantage) => <>{advantage} <i>✱</i> </>)}</span>
      ))}
    </div>
  </div>
  <p class="visually-hidden">{ADVANTAGES.join(". ")}.</p>

  {tiles.length > 0 && (
    <section class="wrap" aria-labelledby="catalog-heading">
      <header class="head">
        <p class="label">{sectionNumber()} / Категории</p>
        <div class="head__row">
          <h2 id="catalog-heading">Каталог</h2>
          <a class="btn btn--ghost btn--sm" href="/catalog/">Все зеркала</a>
        </div>
      </header>
      <CatalogTiles tiles={tiles} />
    </section>
  )}

  {showcase !== null && showcase.products.length > 0 && (
    <section class="wrap" aria-labelledby="showcase-heading">
      <header class="head">
        <p class="label">{sectionNumber()} / {showcase.category.name}</p>
        <div class="head__row">
          <h2 id="showcase-heading">Из каталога</h2>
          <a class="btn btn--ghost btn--sm" href="/catalog/">Весь каталог</a>
        </div>
      </header>
      <div class="grid-4">
        {showcase.products.map((product) => <CatalogCard categorySlug={showcase.category.slug} product={product} />)}
      </div>
      <OfferNote />
    </section>
  )}

  <section class="wrap" aria-labelledby="steps-heading">
    <header class="head">
      <p class="label">{sectionNumber()} / Как это работает</p>
      <div class="head__row"><h2 id="steps-heading">Как оформить заявку</h2></div>
    </header>
    <Rows items={STEPS} level={3} />
  </section>

  <section class="wrap" id="inquiry" aria-labelledby="inquiry-heading">
    <header class="head">
      <p class="label">{sectionNumber()} / Заявка</p>
      <div class="head__row"><h2 id="inquiry-heading">Не нашли подходящее? Сделаем по вашему эскизу</h2></div>
    </header>
    <div class="inquiry">
      <div class="inquiry__text">
        <p>Оставьте контакты — менеджер уточнит размеры, сроки и стоимость. Ответим в течение рабочего дня; оплаты и обязательств на сайте нет.</p>
        {(contacts !== null || social.length > 0) && (
          <ul class="index">
            {contacts !== null && <IndexRow href={`tel:${contacts.phone}`} label={contacts.phone_display} />}
            {contacts !== null && <IndexRow href={`mailto:${contacts.email}`} label={contacts.email} />}
            {social.map((link) => <IndexRow href={link.value} label={link.label} external />)}
          </ul>
        )}
      </div>
      <InquiryForm client:visible />
    </div>
  </section>
</BaseLayout>
