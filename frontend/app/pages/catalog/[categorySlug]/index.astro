---
import CatalogCard from "../../../components/CatalogCard.astro";
import NotFound from "../../../components/NotFound.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { internalCatalogApi, type ListEnvelope, type ProductSummary } from "../../../lib/catalog-api.ts";
import { foundOrNull } from "../../../lib/not-found.ts";

const api = internalCatalogApi();
const categorySlug = Astro.params.categorySlug ?? "";
const products: ListEnvelope<ProductSummary> | null = await foundOrNull(categorySlug, (slug) =>
  api.categoryProducts(slug),
);
if (products === null) {
  Astro.response.status = 404;
}
const category = products === null ? undefined : (await api.categories()).items.find((item) => item.slug === categorySlug);
---

{products === null ? (
  <NotFound
    heading="Категория не найдена"
    lead="Возможно, в адресе опечатка или категория больше не производится."
    description="Такой категории зеркал нет в каталоге Memiro."
  />
) : (
  <BaseLayout
    title={`${category?.name ?? "Каталог зеркал"} — Memiro`}
    description={`Зеркала мастерской Memiro в категории «${category?.name ?? "Каталог зеркал"}»: размеры, опции и цена от минимальной конфигурации.`}
  >
    <div class="cat-head wrap"><h1 class="h-section">{category?.name ?? "Каталог зеркал"}</h1><span class="count">{products.total} товаров</span></div>
    <div class="wrap section"><div class="grid-3">{products.items.map((product) => <CatalogCard categorySlug={categorySlug} product={product} />)}</div></div>
  </BaseLayout>
)}
