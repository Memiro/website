---
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import CatalogCard from "../../../../components/CatalogCard.astro";
import NotFound from "../../../../components/NotFound.astro";
import OfferNote from "../../../../components/OfferNote.astro";
import Calculator from "../../../../islands/Calculator.vue";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { internalCatalogApi, type ProductCard, type ProductSummary } from "../../../../lib/catalog-api.ts";
import { coverImageUrl, mediaUrl } from "../../../../lib/media.ts";
import { productPath } from "../../../../lib/navigation.ts";
import { ordinal } from "../../../../lib/ordinal.ts";
import { foundOrNull } from "../../../../lib/not-found.ts";
import { absoluteUrl, productJsonLd } from "../../../../lib/seo.ts";
import { productSpecs } from "../../../../lib/specs.ts";

const RELATED_SIZE = 4;
const PROMISES = [
  "Своё производство — цена без посредников",
  "Изготовление от 1 рабочего дня, срок зависит от сложности",
  "Доставка и монтаж по Санкт-Петербургу и области",
];
const api = internalCatalogApi();
const categorySlug = Astro.params.categorySlug ?? "";
const productSlug = Astro.params.productSlug ?? "";
const product: ProductCard | null = await foundOrNull(productSlug, (slug) => api.product(slug));
if (product === null) {
  Astro.response.status = 404;
}
const price = product === null || product.price_from === null
  ? null
  : new Intl.NumberFormat("ru-RU").format(Number(product.price_from));
const cover = product === null ? "" : coverImageUrl(product.image_keys);
const thumbs = product === null ? [] : product.image_keys.map((key) => mediaUrl(key));
const specs = product === null ? [] : productSpecs(product.attributes);
const category = product === null ? undefined : (await api.categories()).items.find((item) => item.slug === categorySlug);
const categoryName = category?.name ?? "Каталог";

let related: ProductSummary[] = [];
if (product !== null) {
  const neighbours = await foundOrNull(categorySlug, (slug) => api.categoryProducts(slug));
  related = (neighbours?.items ?? []).filter((item) => item.slug !== product.slug).slice(0, RELATED_SIZE);
}

const crumbs = product === null ? [] : [
  { href: "/", label: "Главная" },
  { href: "/catalog/", label: "Каталог" },
  { href: `/catalog/${categorySlug}/`, label: categoryName },
  { href: productPath(categorySlug, product.slug), label: product.name },
];
---

{product === null ? (
  <NotFound
    heading="Товар не найден"
    lead="Возможно, в адресе опечатка или зеркало больше не производится."
    description="Такого зеркала нет в каталоге Memiro."
  />
) : (
  <BaseLayout
    title={`${product.name} — Memiro`}
    description={product.description}
    ogType="product"
    ogImage={cover}
    crumbs={crumbs}
    jsonLd={[productJsonLd({
      name: product.name,
      description: product.description,
      url: absoluteUrl(Astro.site, Astro.url.pathname),
      image: absoluteUrl(Astro.site, cover),
      priceFrom: product.price_from,
    })]}
  >
    <Breadcrumbs crumbs={crumbs} />
    <div class="pdp wrap">
      <div class="gallery">
        <div class="gallery__main"><img data-gallery-main src={cover} alt={product.name} /></div>
        {thumbs.length > 1 && (
          <div class="thumbs">
            {thumbs.map((source, index) => (
              <button class={index === 0 ? "on" : undefined} type="button" aria-pressed={index === 0 ? "true" : "false"} data-src={source}>
                <img src={source} alt={`${product.name} — фото ${index + 1}`} loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>
      <div class="info">
        <header class="info__head">
          <p class="label">{categoryName}</p>
          <h1>{product.name}</h1>
          <p class="info__desc">{product.description}</p>
        </header>
        {price !== null && (
          <div class="info__price"><span class="price-now">от {price} ₽</span><span class="price-note">цена минимальной конфигурации</span></div>
        )}
        {product.variants.length > 0 && (
          <div class="variants">
            <h2>Типовые размеры</h2>
            <table>
              <tbody>
                {product.variants.map((variant) => (
                  <tr>
                    <th scope="row">{variant.width_mm} × {variant.height_mm} мм</th>
                    <td>{new Intl.NumberFormat("ru-RU").format(Number(variant.price))} ₽</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <Calculator client:visible product={product} />
        <OfferNote />
        {specs.length > 0 && (
          <div class="specs">
            <h2>Характеристики</h2>
            <dl>{specs.map((spec) => <div class="spec"><dt>{spec.name}</dt><dd>{spec.value}</dd></div>)}</dl>
          </div>
        )}
        <ul class="promises">
          {PROMISES.map((promise, index) => (
            <li><span class="promises__n">{ordinal(index + 1)}</span>{promise}</li>
          ))}
        </ul>
      </div>
    </div>

    {related.length > 0 && (
      <section class="wrap" aria-labelledby="related-heading">
        <header class="head">
          <p class="label">Ещё в разделе</p>
          <div class="head__row">
            <h2 id="related-heading">Похожие зеркала</h2>
            <a class="btn btn--ghost btn--sm" href={`/catalog/${categorySlug}/`}>Весь раздел</a>
          </div>
        </header>
        <div class="carousel grid-4">{related.map((item) => <CatalogCard categorySlug={categorySlug} product={item} />)}</div>
      </section>
    )}
  </BaseLayout>
)}

<script>
  import { mountGallery } from "../../../../islands/gallery.ts";

  mountGallery(document);
</script>
