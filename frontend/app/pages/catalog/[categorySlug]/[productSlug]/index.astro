---
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import CatalogCard from "../../../../components/CatalogCard.astro";
import NotFound from "../../../../components/NotFound.astro";
import OfferNote from "../../../../components/OfferNote.astro";
import Calculator from "../../../../islands/Calculator.vue";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { internalCatalogApi, type ProductCard, type ProductSummary } from "../../../../lib/catalog-api.ts";
import { imageSrcSet, mediaUrl, photographUrl } from "../../../../lib/media.ts";
import { GALLERY_SIZES, THUMB_SIZES } from "../../../../lib/image-sizes.ts";
import { productPath, redirectTarget } from "../../../../lib/navigation.ts";
import { foundOrNull } from "../../../../lib/not-found.ts";
import { relatedProducts } from "../../../../lib/related.ts";
import { absoluteUrl, productJsonLd } from "../../../../lib/seo.ts";
import { productDescription, productTitle } from "../../../../lib/titles.ts";

const api = internalCatalogApi();
const categorySlug = Astro.params.categorySlug ?? "";
const productSlug = Astro.params.productSlug ?? "";
const product: ProductCard | null = await foundOrNull(productSlug, (slug) => api.product(slug));
if (product === null) {
  Astro.response.status = 404;
} else if (product.category_slug !== categorySlug) {
  // A card opened under a foreign category is one page with two addresses;
  // the real one is the only address to index (ADR-0013).
  return Astro.redirect(redirectTarget(productPath(product.category_slug, product.slug), Astro.url.search), 301);
}
const price = product === null || product.price_from === null
  ? null
  : new Intl.NumberFormat("ru-RU").format(Number(product.price_from));
const cover = product === null ? "" : photographUrl(product.images[0]);
// The gallery draws one photograph at a time, so a thumbnail carries the
// candidates of its own photo: the island swaps both, and the browser keeps
// choosing a width instead of falling back to the original.
const photographs = product === null ? [] : product.images.map((image, index) => ({
  src: mediaUrl(image.key),
  srcset: imageSrcSet(image),
  alt: `${product.name} — фото ${index + 1}`,
}));
const coverSrcSet = product === null ? undefined : imageSrcSet(product.images[0]);
const categoryName = product === null ? "" : product.category_name;

let related: ProductSummary[] = [];
if (product !== null) {
  related = (await foundOrNull(categorySlug, (slug) => relatedProducts(api, slug, product))) ?? [];
}

const crumbs = product === null ? [] : [
  { href: "/", label: "Главная" },
  { href: "/catalog/", label: "Каталог" },
  { href: `/catalog/${categorySlug}/`, label: categoryName },
  { href: productPath(categorySlug, product.slug), label: product.name },
];
---

{product === null ? (
  <NotFound
    heading="Товар не найден"
    lead="Возможно, в адресе опечатка или зеркало больше не производится."
    description="Такого зеркала нет в каталоге Memiro."
  />
) : (
  <BaseLayout
    title={productTitle(product.name)}
    description={productDescription(product.name, product.price_from, product.description)}
    ogType="product"
    ogImage={cover}
    crumbs={crumbs}
    jsonLd={[productJsonLd({
      name: product.name,
      description: product.description,
      url: absoluteUrl(Astro.site, Astro.url.pathname),
      image: absoluteUrl(Astro.site, cover),
      priceFrom: product.price_from,
    })]}
  >
    <Breadcrumbs crumbs={crumbs} />
    <div class="pdp wrap">
      <div class="gallery">
        <div class="gallery__main">
          <img data-gallery-main src={cover} srcset={coverSrcSet} sizes={GALLERY_SIZES} alt={product.name} />
        </div>
        {photographs.length > 1 && (
          <div class="thumbs">
            {photographs.map((photograph, index) => (
              <button
                class={index === 0 ? "on" : undefined}
                type="button"
                aria-pressed={index === 0 ? "true" : "false"}
                data-src={photograph.src}
                data-srcset={photograph.srcset}
              >
                <img src={photograph.src} srcset={photograph.srcset} sizes={THUMB_SIZES} alt={photograph.alt} loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>
      <div class="info">
        <header class="info__head">
          <p class="label">{categoryName}</p>
          <h1>{product.name}</h1>
          <p class="info__desc">{product.description}</p>
        </header>
        {price !== null && (
          <div class="info__price"><span class="price-now">от {price} ₽</span><span class="price-note">цена минимальной конфигурации</span></div>
        )}
        {product.variants.length > 0 && (
          <div class="variants">
            <h2>Типовые размеры</h2>
            <table>
              <tbody>
                {product.variants.map((variant) => (
                  <tr>
                    <th scope="row">{variant.width_mm} × {variant.height_mm} мм</th>
                    <td>{new Intl.NumberFormat("ru-RU").format(Number(variant.price))} ₽</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        <Calculator client:visible product={product} />
        <OfferNote />
      </div>
    </div>

    {related.length > 0 && (
      <section class="wrap" aria-labelledby="related-heading">
        <header class="head">
          <p class="label">Ещё в разделе</p>
          <div class="head__row">
            <h2 id="related-heading">Похожие зеркала</h2>
            <a class="btn btn--ghost btn--sm" href={`/catalog/${categorySlug}/`}>Весь раздел</a>
          </div>
        </header>
        <div class="carousel grid-4">{related.map((item) => <CatalogCard categorySlug={categorySlug} product={item} />)}</div>
      </section>
    )}
  </BaseLayout>
)}

<script>
  import { mountGallery } from "../../../../islands/gallery.ts";

  mountGallery(document);
</script>
