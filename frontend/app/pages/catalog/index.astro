---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CatalogTiles from "../../components/CatalogTiles.astro";
import EmptyState from "../../components/EmptyState.astro";
import PageHead from "../../components/PageHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { internalCatalogApi } from "../../lib/catalog-api.ts";
import { categoryPlural } from "../../lib/plural.ts";
import { itemListJsonLd } from "../../lib/seo.ts";
import { catalogTiles } from "../../lib/tiles.ts";

const tiles = await catalogTiles(internalCatalogApi());
const crumbs = [{ href: "/", label: "Главная" }, { href: "/catalog/", label: "Каталог" }];
---

<BaseLayout
  title="Каталог зеркал — Memiro"
  description="Каталог интерьерных зеркал мастерской Memiro: подборки и категории зеркал с ценой от минимальной конфигурации."
  crumbs={crumbs}
  jsonLd={[itemListJsonLd(Astro.site, tiles)].filter((document) => document !== null)}
>
  <Breadcrumbs crumbs={crumbs} />
  <PageHead label={`${tiles.length} ${categoryPlural(tiles.length)}`} heading="Каталог зеркал" />
  <div class="wrap page-body">
    {tiles.length > 0 ? <CatalogTiles tiles={tiles} /> : <EmptyState text="Каталог наполняется — загляните позже." href="/" action="На главную" />}
  </div>
</BaseLayout>
