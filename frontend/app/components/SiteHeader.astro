---
import { HEADER_LINKS, INQUIRY_LINK, externalLinkAttrs, isCurrentPath, type NavigationLink } from "../lib/navigation.ts";
import { SITE_NAME } from "../lib/site.ts";
import type { Site } from "../lib/site-api.ts";

interface Props { site: Site; }
const { site } = Astro.props;
const contacts = site.contacts;
const pathname = Astro.url.pathname;
type MenuLink = NavigationLink & { isCurrent?: boolean; external?: boolean };
const links: MenuLink[] = HEADER_LINKS.map((link) => ({ ...link, isCurrent: isCurrentPath(pathname, link.href) }));
// An unfilled contact draws no link: the storefront points nowhere.
const phone: MenuLink | null = contacts !== null && contacts.phone !== "" ? { href: `tel:${contacts.phone}`, label: contacts.phone_display } : null;
const messenger: MenuLink | null = contacts !== null && contacts.max_link !== "" ? { href: contacts.max_link, label: "MAX", external: true } : null;
const menuLinks = [...links, INQUIRY_LINK, phone, messenger].filter((link): link is MenuLink => link !== null);
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/"><img src="/img/logo/logo3-black.svg" alt={SITE_NAME} width="434" height="56" /></a>
    <nav class="nav__center" aria-label="Основная навигация">
      {links.map((link) => <a class="nav__link" href={link.href} aria-current={link.isCurrent ? "page" : undefined}>{link.label}</a>)}
    </nav>
    <div class="nav__right">
      {phone !== null && <a class="nav__phone" href={phone.href}>{phone.label}</a>}
      {/* Not a shopping cart: the site reserves nothing and takes no payment. */}
      <a class="btn btn--sm" href={INQUIRY_LINK.href}>
        {INQUIRY_LINK.label}
        <span class="nav__count" data-inquiry-counter hidden>0</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <button class="nav__burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Меню">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M3 7h18" /><path d="M3 12h18" /><path d="M3 17h18" /></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Меню сайта" hidden>
    {menuLinks.map((link) => (
      <a href={link.href} aria-current={link.isCurrent ? "page" : undefined} {...externalLinkAttrs(link.external ?? false)}>
        {link.label}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </nav>
</header>

<script>
  import { mountHeader } from "../islands/header.ts";

  mountHeader(document);
</script>
