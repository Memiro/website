---
import { HEADER_LINKS, isCurrentPath } from "../lib/navigation";

const pathname = Astro.url.pathname;
---

<header class="nav">
  <div class="wrap nav-row">
    <a class="wordmark" href="/">memiro</a>
    <nav class="nav-links" aria-label="Основная навигация">
      {HEADER_LINKS.map((link) => {
        const isCurrent = isCurrentPath(pathname, link.href);
        return <a class={isCurrent ? "active" : undefined} href={link.href} aria-current={isCurrent ? "page" : undefined}>{link.label}</a>;
      })}
    </nav>
    <div class="nav-side">
      <a class="nav-phone" href="tel:+79812304050">+7 981 230-40-50</a>
      <div class="icon-row"><a class="icon-btn" href="https://t.me/memiro_shop" title="Telegram" aria-label="Написать в Telegram"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M3.5 20.5l1.3-4A8.4 8.4 0 1 1 8 19.7l-4.5.8z" /><path d="M8.6 15V9l3.4 3.7L15.4 9v6" /></svg></a></div>
    </div>
  </div>
</header>
