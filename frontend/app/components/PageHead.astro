---
import { productPlural } from "../lib/plural.ts";

interface Props { label: string; heading: string; productCount?: number; }
const { label, heading, productCount } = Astro.props;
---

<div class="wrap">
  <header class="head head--page">
    <p class="label">{label}</p>
    <div class="head__row">
      <h1 class="h-section">{heading}</h1>
      {productCount !== undefined && <span class="head__count">{productCount} {productPlural(productCount)}</span>}
    </div>
  </header>
</div>
