---
import type { Work } from "../lib/catalog-api.ts";
import { imageSrcSet, photographUrl } from "../lib/media.ts";
import { WORK_SIZES } from "../lib/image-sizes.ts";
import { productPath } from "../lib/navigation.ts";

interface Props { work: Work; }
const { work } = Astro.props;
// A work whose mirror the catalogue no longer sells stays a still figure: the tile
// keeps the photograph and loses the address, instead of pointing at the hidden.
const href = work.product === null ? null : productPath(work.product.category_slug, work.product.slug);
const Tile = href === null ? Fragment : "a";
const link = href === null ? {} : { class: "card-link", href };
---

<figure class="work">
  <Tile {...link}>
    <div class="pic">
      <img
        src={photographUrl(work.photo)}
        srcset={imageSrcSet(work.photo)}
        sizes={WORK_SIZES}
        alt={work.title}
        loading="lazy"
      />
    </div>
    <figcaption>
      <span>{work.title}</span>
      {work.description !== "" && <span class="work__note">{work.description}</span>}
      {href !== null && <span class="work__go">Смотреть зеркало <span class="arrow" aria-hidden="true">→</span></span>}
    </figcaption>
  </Tile>
</figure>
