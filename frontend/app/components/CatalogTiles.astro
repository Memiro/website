---
import { ordinal } from "../lib/ordinal.ts";
import { tileSizes } from "../lib/image-sizes.ts";
import { imageSrcSet, photographUrl } from "../lib/media.ts";
import { tileSpan, type Tile } from "../lib/tiles.ts";

interface Props { tiles: Tile[]; }
const { tiles } = Astro.props;
---

{tiles.length > 0 && (
  <div class="bento">
    {tiles.map((tile, index) => (
      <a class={`cell cell--${tileSpan(index)}`} href={tile.href}>
        {/* The first tile is what the browser paints first on every page
            that shows a bento, so the flags are decided here and not by the
            calling page: a new page would otherwise bring a lazy LCP back. */}
        <img
          src={photographUrl(tile.image)}
          srcset={imageSrcSet(tile.image)}
          sizes={tileSizes(tileSpan(index))}
          alt=""
          loading={index === 0 ? "eager" : "lazy"}
          fetchpriority={index === 0 ? "high" : undefined}
        />
        <span class="chip"><span class="chip__n">{ordinal(index + 1)}</span>{tile.label}</span>
      </a>
    ))}
  </div>
)}
