---
import type { ProductSummary } from "../lib/catalog-api.ts";
import { coverImageUrl } from "../lib/media.ts";

interface Props { categorySlug: string; product: ProductSummary; }
const { categorySlug, product } = Astro.props;
// A product without precalculated variants shows no price at all (ADR-0007):
// a placeholder in its place would be a lie.
const price = product.price_from === null ? null : new Intl.NumberFormat("ru-RU").format(Number(product.price_from));
---

<article class="product-card">
  <a class="card-link" href={`/catalog/${categorySlug}/${product.slug}/`}>
    <div class="pic"><img src={coverImageUrl(product.image_keys)} alt={product.name} loading="lazy" /></div>
    <div class="meta"><div class="name">{product.name}</div>{price !== null && <span class="price">от {price} ₽</span>}</div>
  </a>
</article>
