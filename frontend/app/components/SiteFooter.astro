---
import SellerRequisites from "./SellerRequisites.astro";
import { CONTACTS, SOCIAL_LINKS } from "../lib/contacts.ts";
import { FOOTER_CATALOG_LINKS, FOOTER_CUSTOMER_LINKS, FOOTER_LEGAL_LINKS } from "../lib/navigation.ts";
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <a class="wordmark" href="/">memiro</a>
      <p class="footer-about">Производство интерьерных зеркал на заказ в Санкт-Петербурге: изготовление, доставка и установка.</p>
    </div>
    <div>
      <h4>Каталог</h4>
      <ul>{FOOTER_CATALOG_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>Покупателю</h4>
      <ul>{FOOTER_CUSTOMER_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>Контакты</h4>
      <ul>
        <li><a href={`tel:${CONTACTS.phone}`}>{CONTACTS.phoneDisplay}</a></li>
        <li><a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a></li>
        {SOCIAL_LINKS.map((link) => <li><a href={link.href} target="_blank" rel="noopener">{link.label}</a></li>)}
        <li>{CONTACTS.address}</li>
      </ul>
      <SellerRequisites />
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© memiro, 2026</span>
    {FOOTER_LEGAL_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    <span>{CONTACTS.city}</span>
  </div>
</footer>
