---
import PageHead from "./PageHead.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  heading: string;
  lead: string;
  description: string;
}

const { heading, lead, description } = Astro.props;
---

<BaseLayout title={`${heading} — Memiro`} description={description}>
  <PageHead label="Ошибка 404" heading={heading} />
  <div class="wrap page">
    <div class="page__lead"><p>{lead}</p></div>
    <div class="page__actions">
      <slot>
        <a class="btn" href="/catalog/">Вернуться в каталог <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/">На главную</a>
      </slot>
    </div>
  </div>
</BaseLayout>
