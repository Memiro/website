---
import { externalLinkAttrs } from "../lib/navigation.ts";

interface Props { href: string; label: string; external?: boolean; }
const { href, label, external = false } = Astro.props;
---

<li>
  <a href={href} {...externalLinkAttrs(external)}>
    <span>{label}</span><span class="arrow" aria-hidden="true">→</span>
  </a>
</li>
